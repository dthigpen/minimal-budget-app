<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- TODO support color schemes, need to figure out how that works with skeleton css -->
    <!-- <meta name="color-scheme" content="light dark" /> -->

    <!-- <link rel="stylesheet" type="text/css" href="css/vender/pico.min.css" /> -->
    <link rel="stylesheet" type="text/css" href="css/vender/beer.min.css" />
    <link rel="stylesheet" href="css/style.css" />
    <title>Minimal Budget App</title>
  </head>
  <body>
    <script>
      // Shim for Object.hasOwn
      if (!Object.hasOwn) {
        Object.hasOwn = function (obj, prop) {
          return Object.prototype.hasOwnProperty.call(obj, prop);
        };
      }
      // Shim for Object.groupBy
      if (!Object.groupBy) {
        Object.groupBy = function (items, callback) {
          if (items == null) {
            throw new TypeError("Cannot convert undefined or null to object");
          }
          if (typeof callback !== "function") {
            throw new TypeError(callback + " is not a function");
          }
      
          const result = {};
          for (let i = 0; i < items.length; i++) {
            const item = items[i];
            const key = callback(item, i, items);
            if (!Object.prototype.hasOwnProperty.call(result, key)) {
              result[key] = [];
            }
            result[key].push(item);
          }
          return result;
        };
      }
      // Shim for Array.prototype.at
      if (!Array.prototype.at) {
        Array.prototype.at = function (index) {
          index = Math.trunc(index) || 0;
          if (index < 0) index += this.length;
          if (index < 0 || index >= this.length) return undefined;
          return this[index];
        };
      }
    </script>
    <script type="module" src="js/index.js"></script>
  </body>
</html>
